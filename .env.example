# --- WhatsApp Cloud API ------------------------------------------------------
# Meta → WhatsApp → Configuración de la API. El token debe ser permanente (de
# un usuario del sistema), no el temporal de 24 h de la pantalla de pruebas.
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_GRAPH_VERSION=v25.0

# Segmento secreto de la URL del webhook Y token del handshake. Genera uno con:
#   openssl rand -hex 32
# La URL que se registra en Meta queda: https://TU-DOMINIO/webhook/<este valor>
# Sin esto el endpoint es público: cualquiera que adivine el dominio puede
# inyectarle mensajes al bot.
WEBHOOK_TOKEN=

# Meta → Configuración de la app → Clave secreta. Con esto se verifica la firma
# de cada webhook. Vacío = NO se verifica y el segmento secreto es lo único que
# protege. Ponlo.
META_APP_SECRET=

# --- Cerebro -----------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# Vacíos = defaults del proveedor.
LLM_TEMPERATURE=
# ⚠️ Con un modelo que RAZONA, un tope bajo no acorta la respuesta: el tope se
# gasta razonando y el contenido llega VACÍO. La brevedad se pide en el
# conocimiento, no aquí. Déjalo vacío salvo que sepas que lo necesitas.
LLM_MAX_TOKENS=

# --- Conocimiento ------------------------------------------------------------
CONOCIMIENTO_PATH=conocimiento/colegio-psicologos.md
NOMBRE_AGENTE=el canal informativo del Colegio
ZONA_HORARIA=America/Mexico_City

# --- Comportamiento ----------------------------------------------------------
# Segundos que espera para juntar una ráfaga en un solo turno.
COALESCE_SEGUNDOS=4

# Horas de silencio tras las que la IA se reactiva sola, después de que una
# persona contestó desde el teléfono y la pausó.
REACTIVAR_TRAS_HORAS=24

HISTORIAL_MENSAJES=10

# Modo prueba: CSV de números a los que SÍ responde. Vacío = responde a todos.
# Arranca con tu número aquí y vacíalo cuando estés conforme.
NUMEROS_PERMITIDOS=

DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/botfaq
PORT=8000
